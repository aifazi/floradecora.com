# ─────────────────────────────────────────────────────────────
# Coolify Environment Variables for Flora Decora
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# General
APP_NAME=floradecora
NETWORK_NAME=coolify
FRONTEND_PORT=3000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=floradecora

# Backend
JWT_SECRET=generate-with-openssl-rand-base64-32
ADMIN_API_KEY=change-me-admin-key
COOKIE_SECURE=false
ALLOW_LOCAL_CORS=true
ALLOW_INSECURE_COOKIE=true
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 (optional, for image uploads)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floradecora
CDN_URL=https://cdn.aifazi.net

# Frontend
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WEB3FORMS_KEY=
NEXT_PUBLIC_WEB3FORMS_KEY=
# Loading screen (ms, default 2600 — set 3000-3500 for longer premium reveal)
NEXT_PUBLIC_LOADING_MS=2600
