# ── Frontend env ──
# BACKEND_URL is server-only (Docker: http://backend:3002, Render: fromService host).
# Never expose secrets as NEXT_PUBLIC_ — they leak to client bundle.
BACKEND_URL=http://backend:3002
# For Vercel/hosted frontend outside Docker, set NEXT_PUBLIC_API_URL to your API:
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api
#
# Contact form — SERVER-ONLY (do not prefix with NEXT_PUBLIC_)
WEB3FORMS_KEY=your-web3forms-access-key
# Cloudflare Turnstile (optional but recommended):
# https://www.cloudflare.com/products/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
#
# Secrets note:
# - Rotate TURNSTILE_SECRET_KEY / WEB3FORMS_KEY in prod via hosting env vars.
# - This file is an example — real values go in .env.local (gitignored).
