# Backend API — optional, for server-side proxy to DB
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api
# BACKEND_URL=http://backend:3002 — set in docker-compose, not needed on Vercel
# Contact form — server-side only (never expose as NEXT_PUBLIC_)
WEB3FORMS_KEY=your-web3forms-access-key
# Cloudflare Turnstile (optional but recommended) — get at https://www.cloudflare.com/products/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
