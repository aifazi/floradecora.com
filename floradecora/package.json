{
  "name": "flora-decora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "optimize-images": "node scripts/optimize-images.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.26",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jose": "^5.9.6",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "glob": "^11.0.3",
    "postcss": "^8.4.49"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
