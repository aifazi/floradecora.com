# scripts/.env.local — local-only secrets for deploy scripts. DO NOT COMMIT.
# Copy this file to scripts/.env.local (it is gitignored) and fill in real values.
# Generate auth secrets: openssl rand -base64 48

# --- Render API (https://dashboard.render.com/u/settings#api-keys) ---
RENDER_API_TOKEN=
BACKEND_SERVICE_ID=
FRONTEND_SERVICE_ID=

# --- Supabase (Dashboard -> Project Settings -> Database) ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Supabase Postgres connection strings (Dashboard -> Database -> Connection string)
DATABASE_URL=
DIRECT_URL=

# --- Backend auth (must match what is set on Render dashboard for floradecora-backend) ---
ADMIN_API_KEY=
JWT_SECRET=

# --- Vercel (frontend) ---
BACKEND_URL=https://floradecora-backend.onrender.com
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
WEB3FORMS_KEY=
