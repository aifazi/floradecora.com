# Database — choose ONE:
# Local Docker: postgresql://postgres:postgres@flora-db:5432/floradecora
# Supabase (via PgBouncer + direct):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# ── Secrets ──
# Generate strong secrets for PRODUCTION (rotate before launch):
#   openssl rand -base64 48  # ADMIN_API_KEY (64+ chars)
#   openssl rand -base64 32  # JWT_SECRET (>=32 chars, required)
# NEVER commit real .env — it is gitignored. Use Render/Railway env vars in prod.
ADMIN_API_KEY="change-me-64-char-random--generate-with-openssl-rand-base64-48"
JWT_SECRET="change-me-32-char-min--generate-with-openssl-rand-base64-32"
# R2 / S3 (for media)
R2_ENDPOINT="https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET="floradecora"
CDN_URL="https://cdn.aifazi.net"
# App
PORT=3002
# CORS — prod must be https://floradecora.com,https://www.floradecora.com (no localhost)
CORS_ORIGIN="https://floradecora.com,https://www.floradecora.com"
# COOKIE_SECURE — set true in production (https), false for local http
COOKIE_SECURE=true
# Turnstile (optional but recommended for /api/contact)
TURNSTILE_SECRET_KEY=""
# Web3Forms fallback (if not using DB for contact)
WEB3FORMS_KEY=""
# CDN / R2 — if empty, uploads fall back to local warn (see CdnService)
# R2_ENDPOINT https://<account>.r2.cloudflarestorage.com — must be allow-listed (assertSafeUrl)
